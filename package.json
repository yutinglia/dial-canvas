{
  "name": "dial-canvas-ext",
  "description": "Firefox-first Dial Canvas new tab extension",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "yutinglia",
  "homepage": "https://github.com/yutinglia/dial-canvas",
  "repository": {
    "type": "git",
    "url": "https://github.com/yutinglia/dial-canvas.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "submit:firefox": "wxt submit --firefox-zip .output/*-firefox.zip --firefox-sources-zip .output/*-sources.zip",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.4.4",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wxt": "^0.21.2"
  }
}
